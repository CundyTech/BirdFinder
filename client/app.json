{
  "expo": {
    "name": "BirdFinderClient",
    "slug": "BirdFinderClient",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "updates": {
      "enabled": false
    },
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow BirdFinder to access your camera to identify birds.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0e1116"
        }
      ]
    ],
    "android": {
      "package": "com.cundytech.birdfinder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1f9d6b"
      }
    },
    "ios": {
      "bundleIdentifier": "com.cundytech.birdfinder"
    }
  }
}
