{
  "name": "BirdFinderClient",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "cross-env EXPO_PUBLIC_API_KEY=test-api-key jest",
    "test:watch": "cross-env EXPO_PUBLIC_API_KEY=test-api-key jest --watch"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "^52.0.49",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.6",
    "expo-keep-awake": "~14.0.3",
    "expo-modules-autolinking": "~2.0.0",
    "expo-modules-core": "~2.2.0",
    "expo-splash-screen": "~0.29.24",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-svg": "^15.15.5",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eas-cli": "^21.6.0",
    "jest": "~29.7.0",
    "jest-expo": "~52.0.6"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-redux|@reduxjs/.*|immer)",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "moduleNameMapper": {
      "^react-native-vector-icons$": "@expo/vector-icons",
      "^react-native-vector-icons/(.*)": "@expo/vector-icons/$1",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    }
  }
}
